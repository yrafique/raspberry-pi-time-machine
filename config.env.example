# Copy this file to config.env and edit it. config.env is ignored by git.
#   cp config.env.example config.env

# The USB disk to ERASE and use for backups. Find it with: lsblk -o NAME,SIZE,MODEL,TRAN
DISK=/dev/sda

# Filesystem label and where the disk is mounted.
LABEL=TimeMachine
MOUNT_POINT=/srv/timemachine

# One name per Mac. Each gets its own login and its own share, TimeMachine-<Name>.
# Lowercase letters, digits, '-' or '_'. Example: "personal work" -> TimeMachine-Personal, TimeMachine-Work
USERS="personal"

# SMART device type. 'sat' works for most USB-to-SATA bridges. Use 'auto' for a directly attached disk.
SMART_DEVICE_TYPE=sat
